<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.1.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.1.0
         http://maven.apache.org/xsd/maven-4.1.0.xsd">
    <modelVersion>4.1.0</modelVersion>

    <parent>
        <groupId>dev.ikm.dex.source</groupId>
        <artifactId>sources</artifactId>
    </parent>

    <!-- Fixed by IKE-INGEST: the topic library is always `topics`. -->
    <artifactId>topics</artifactId>
    <packaging>pom</packaging>

    <name>Topics</name>
    <description>
        Topic library. Publishes an AsciiDoc source ZIP (classifier adoc) consumed by the assemblies.
    </description>

    <properties>
        <ike.skip.prince>true</ike.skip.prince>
        <ike.skip.html-single>true</ike.skip.html-single>
        <ike.skip.pdf-default>true</ike.skip.pdf-default>
    </properties>

    <build>
        <plugins>
            <!--
              Topic fragments reference images relative to imagesdir (for example ext/{doc}/x.png) and may not
              set :imagesdir: themselves (IKE-ASCIIDOC-FRAGMENT). index.adoc and the assemblies set it, but the
              per-topic HTML that Prince renders does not, so its <img> paths lacked the images/ prefix and
              Prince could not open them. The trailing @ makes this a default that a document can still override.
              A .asciidoctorconfig cannot do this: the build ignores it and overwrites it on every run.
            -->
            <plugin>
                <groupId>org.asciidoctor</groupId>
                <artifactId>asciidoctor-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>generate-print-html-prince</id>
                        <configuration>
                            <attributes>
                                <imagesdir>images@</imagesdir>
                            </attributes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
