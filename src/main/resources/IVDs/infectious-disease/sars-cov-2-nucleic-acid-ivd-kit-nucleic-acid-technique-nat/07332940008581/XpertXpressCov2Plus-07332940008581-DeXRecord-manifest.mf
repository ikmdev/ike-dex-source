{"semantic_chronology":{"public_id":{"uuids":["8f5f37c5-0a4a-4f67-9c62-e88accb816be"]},"referenced_component_public_id":{"uuids":["cb0f79c8-e863-5e49-afcc-a885c884a360"]},"pattern_for_semantic_public_id":{"uuids":["3734fb0a-4c14-5831-9a61-4743af609e7a"]},"semantic_versions":[{"stamp_chronology_public_id":{"uuids":["d3fa9b6b-5cd9-5137-bc3b-4825c3bb1378"]},"fields":[{"string_value":"A new Indication for Use semantic was added to the device concept **GeneXpert® XPRS-COV2-10**, which sits under *Respiratory Specimen Nucleic Acid Sars-Cov-2 Test*. The text describes the Xpert Xpress CoV-2 plus test as a rapid real-time RT-PCR test. It is for qualitative detection of SARS-CoV-2 RNA in nasopharyngeal and anterior nasal swabs from symptomatic individuals, as an aid in diagnosing COVID-19. It also carries the standard cautions that a negative result does not rule out infection and that the result should not be the sole basis for diagnosis or management."}]}]}}
{"semantic_chronology":{"public_id":{"uuids":["4fc33e18-0f1e-4778-aba4-438f43ac81b2"]},"referenced_component_public_id":{"uuids":["cb0f79c8-e863-5e49-afcc-a885c884a360"]},"pattern_for_semantic_public_id":{"uuids":["3734fb0a-4c14-5831-9a61-4743af609e7a"]},"semantic_versions":[{"stamp_chronology_public_id":{"uuids":["c766be0f-987c-5793-9852-a7eb8e44a863"]},"fields":[{"string_value":"A new Indication for Use semantic was added to the device concept **GeneXpert® XPRS-COV2-10**, which sits under *Respiratory Specimen Nucleic Acid Sars-Cov-2 Test*. It describes the Xpert Xpress CoV-2 plus test as a rapid real-time RT-PCR assay. The assay qualitatively detects SARS-CoV-2 RNA in nasopharyngeal and anterior nasal swabs from symptomatic individuals, as an aid in diagnosing COVID-19. It also carries the standard cautions: a negative result does not preclude infection, and the result should not be the sole basis for diagnosis or management."}]}]}}
