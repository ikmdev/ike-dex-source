{"semantic_chronology":{"public_id":{"uuids":["dfd17a6f-aaf1-51d8-846f-7b2644121ee1"]},"referenced_component_public_id":{"uuids":["d5812443-570f-5205-8a81-fb9da0a6f14a"]},"pattern_for_semantic_public_id":{"uuids":["3734fb0a-4c14-5831-9a61-4743af609e7a"]},"semantic_versions":[{"stamp_chronology_public_id":{"uuids":["834bdcaf-6196-558b-844c-42baa48573be"]},"fields":[{"string_value":"The classifier created an inferred-definition record for ABBOTT IRELAND (a Company), stating it is a Device Labeler; its direct parent is Company, which sits under Device Extension Phenomenon. This is classifier output on the Device Extension Module development path, not a manual authoring change."}]}]}}
