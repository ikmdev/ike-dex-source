{"semantic_chronology":{"public_id":{"uuids":["5fb5d67c-0c30-57b8-bf32-5c88de81dd86"]},"referenced_component_public_id":{"uuids":["2944e621-2d12-5629-a797-3bb0cb075162"]},"pattern_for_semantic_public_id":{"uuids":["3734fb0a-4c14-5831-9a61-4743af609e7a"]},"semantic_versions":[{"stamp_chronology_public_id":{"uuids":["ab71d776-0756-5e98-9e75-4eae3721fdeb"]},"fields":[{"string_value":"The Test Performed record for Creatinine (U) [Mass/Vol], attached to VITROS 6802584 (Enzymatic Method, Creatinine), had its Instrument list extended with two analyzers: VITROS 950 Chemistry System and VITROS 5.1FS, both children of Analyzer, Chemistry (Photometric, Discrete), For Clinical Use. The five existing VITROS 6844461, 6802445, 6802413, 6802153 and 6801759 entries are unchanged, and the record's active status did not change."}]}]}}
